    {
      "id": "section-12",
      "order": 12,
      "type": "text",
      "title": "Irrational Numbers",
      "text": "Irrational numbers cannot be written as a fraction of two integers. Their decimal forms do not end and do not repeat. Examples include π and √2."
    },
